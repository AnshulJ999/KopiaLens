# Development image: runs KopiaLens and its test suite from source on Linux.
# Build (from the KopiaLens folder):
#   docker build -f packaging/docker/Dockerfile.dev -t kopialens-dev:py3.13 .
#   docker build -f packaging/docker/Dockerfile.dev --build-arg PYTHON_VERSION=3.14 -t kopialens-dev:py3.14 .
# The source is bind-mounted read-only at /src and copied to /work on start (dev-entry.sh), so a
# Linux run never writes into the Windows checkout or its data folder.
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim

ARG KOPIA_VERSION=0.23.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl fuse3 \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "$(dpkg --print-architecture)" in amd64) k=x64 ;; arm64) k=arm64 ;; *) exit 1 ;; esac; \
    f="kopia-${KOPIA_VERSION}-linux-${k}.tar.gz"; \
    base="https://github.com/kopia/kopia/releases/download/v${KOPIA_VERSION}"; \
    cd /tmp; curl -fsSLO "$base/checksums.txt"; curl -fsSLO "$base/$f"; \
    grep " $f\$" checksums.txt | sha256sum -c -; \
    tar -xzf "$f"; install -m 0755 kopia-*/kopia /usr/local/bin/kopia; \
    rm -rf /tmp/*; kopia --version

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt pytest==9.0.3 pytest-asyncio==1.3.0

COPY packaging/docker/dev-entry.sh /usr/local/bin/dev-entry.sh
RUN chmod 0755 /usr/local/bin/dev-entry.sh

ENV PYTHONDONTWRITEBYTECODE=1 KOPIA_CHECK_FOR_UPDATES=false
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/dev-entry.sh"]
CMD ["bash"]
