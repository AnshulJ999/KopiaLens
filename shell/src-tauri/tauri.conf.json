{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KopiaLens Dev",
  "mainBinaryName": "KopiaLens",
  "version": "0.32.0",
  "identifier": "com.kopialens.desktop.dev",
  "build": {
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCM0Q0QjhFQTBBN0EyNEQKUldSTm9xZWdqa3M5NndIQ0pzUnhwaUpaaW1VZ0gvVFduVE9UT0hCeDFiU1RJSDUvbUlCcGQyMXcK",
      "endpoints": [
        "https://checkin.kopialens.com/v1/update/{{target}}-{{arch}}/{{current_version}}",
        "https://github.com/AnshulJ999/KopiaLens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "KopiaLens",
    "copyright": "© 2026 KopiaLens",
    "shortDescription": "KopiaLens",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "linux": {
      "deb": {
        "recommends": ["fuse3"]
      },
      "rpm": {
        "recommends": ["fuse3"]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
