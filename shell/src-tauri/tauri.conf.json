{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KopiaLens",
  "mainBinaryName": "KopiaLens",
  "version": "0.14.0",
  "identifier": "com.kopialens.desktop",
  "build": {
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "KopiaLens",
    "copyright": "© 2026 KopiaLens",
    "shortDescription": "KopiaLens",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
