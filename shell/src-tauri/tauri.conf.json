{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KopiaLens",
  "mainBinaryName": "KopiaLens",
  "version": "0.28.0",
  "identifier": "com.kopialens.desktop",
  "build": {
    "frontendDist": "../dist-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://checkin.kopialens.com/v1/update/{{target}}-{{arch}}/{{current_version}}",
        "https://github.com/AnshulJ999/KopiaLens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "KopiaLens",
    "copyright": "© 2026 KopiaLens",
    "shortDescription": "KopiaLens",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}
